<section class="veltia-product page-width">
  <div>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag: class: 'veltia-product-image', loading: 'eager' }}{% endif %}</div>
  <div>
    <p>Veltia Labs</p>
    <h1>{{ product.title | escape }}</h1>
    <div>{{ product.description }}</div>
    {% form 'product', product %}
      <label for="variant">Choose your option</label>
      <select id="variant" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}</select>
      <label for="quantity">Quantity</label><input id="quantity" type="number" name="quantity" min="1" value="1">
      <button class="button" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button>
      {{ form | payment_button }}
    {% endform %}
  </div>
</section>
